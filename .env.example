# AI Interviewer — Environment Variables
# Copy to .env and fill values. Never commit .env

# Backend
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://ai_interviewer:ai_interviewer@localhost:5432/ai_interviewer
DATABASE_URL_SYNC=postgresql+psycopg2://ai_interviewer:ai_interviewer@localhost:5432/ai_interviewer

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM Provider (Stage 4+, stub by default)
LLM_PROVIDER=stub
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_MODEL=
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=

# Observability (Stage 9+)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
